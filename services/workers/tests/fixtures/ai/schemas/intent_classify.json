{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["intent", "confidence"],
  "properties": {
    "intent": {
      "type": "string",
      "enum": ["local_business", "company_list", "people", "other"]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
