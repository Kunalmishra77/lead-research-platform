{
  "name": "@leadforge/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "schemas"
  ],
  "scripts": {
    "gen": "node scripts/gen.ts",
    "check": "node scripts/gen.ts --check",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run && uv run --project . --frozen pytest -q"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@leadforge/config": "workspace:*",
    "@types/node": "^24",
    "eslint": "^10.10.0",
    "json-schema-to-typescript": "^16.0.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1"
  }
}
