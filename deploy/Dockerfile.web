# The Next.js app.
#
# Deliberately simple: one build stage, then run from it. A slimmer image is possible (Next's
# standalone output, a pruned production install) and this was written that way first — but these
# files could not be built and tested on the machine that wrote them, and in a pnpm workspace the
# clever version fails in ways that only show up on the host. Fewer moving parts is worth more
# than a smaller image on a first deploy. Slim it once it is running.
#
# Build context is the repo root, not apps/web: the app imports workspace packages from outside it.

FROM node:24-alpine
# turbo ships only glibc binaries -- the lockfile has @turbo/linux-64 and @turbo/linux-arm64 and no
# musl build -- and this image is Alpine, which is musl. Without libc6-compat the turbo binary exits
# 1 with almost no output, so `pnpm build:packages` fails before a single file is compiled. Next.js
# asks for the same package on Alpine.
RUN apk add --no-cache libc6-compat
RUN corepack enable
ENV NEXT_TELEMETRY_DISABLED=1
WORKDIR /repo

# `NEXT_PUBLIC_SENTRY_DSN` is inlined into client bundles at build time, so Sentry has to arrive
# as a build argument. Everything else is read from the environment at runtime.
ARG SENTRY_DSN_WEB=""
ARG SENTRY_ENVIRONMENT="production"
ENV SENTRY_DSN_WEB=$SENTRY_DSN_WEB
ENV SENTRY_ENVIRONMENT=$SENTRY_ENVIRONMENT

# Manifests first, so editing a component does not re-resolve the dependency tree.
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/web/package.json apps/web/
COPY apps/api/package.json apps/api/
COPY db/package.json db/
COPY packages/config/package.json packages/config/
COPY packages/contracts/package.json packages/contracts/
COPY packages/dev-dns/package.json packages/dev-dns/
COPY packages/observability/package.json packages/observability/
COPY infra/setup/package.json infra/setup/
# --prod=false because the build needs devDependencies -- turbo, typescript, nest, next all live
# there. Without it the install silently succeeds with a production-only tree and the build fails a
# step later looking for a compiler. NODE_ENV cannot be relied on to be unset here: Coolify injects
# an ARG declaration for every environment variable before building, and an ARG is visible to RUN
# as an environment variable, so NODE_ENV=production arrives whether or not this file asks for it.
RUN pnpm install --frozen-lockfile --prod=false

COPY . .
# Workspace packages ship as compiled ESM, so they build before anything that imports them.
RUN pnpm build:packages && pnpm --filter @leadforge/web build

ENV NODE_ENV=production
ENV PORT=3000
EXPOSE 3000
CMD ["pnpm", "--filter", "@leadforge/web", "start"]
