{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leadforge.dev/schemas/research-parse-reply.schema.json",
  "title": "ResearchParseReply",
  "description": "What a worker sends back for a research.parse request (ADR-0005). The API waits for exactly one of these on the reply key it generated. A failure is a reply too, so the caller fails immediately instead of waiting out the timeout.",
  "type": "object",
  "additionalProperties": false,
  "required": ["reply_version", "job_id", "ok"],
  "properties": {
    "reply_version": {
      "const": 1
    },
    "job_id": {
      "type": "string",
      "format": "uuid"
    },
    "ok": {
      "type": "boolean"
    },
    "result": {
      "$ref": "#/$defs/ParseResult"
    },
    "error": {
      "$ref": "#/$defs/ParseError"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "ok": {
            "const": true
          }
        },
        "required": ["ok"]
      },
      "then": {
        "properties": {
          "result": {
            "$ref": "#/$defs/ParseResult"
          }
        },
        "required": ["result"]
      },
      "else": {
        "properties": {
          "error": {
            "$ref": "#/$defs/ParseError"
          }
        },
        "required": ["error"]
      }
    }
  ],
  "$defs": {
    "ParseResult": {
      "title": "ParseResult",
      "type": "object",
      "additionalProperties": false,
      "required": ["spec", "feasibility", "needs_confirmation", "confidence", "provenance"],
      "properties": {
        "spec": {
          "description": "A ResearchSpec, already validated against research-spec.schema.json by the worker.",
          "type": "object"
        },
        "feasibility": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Feasibility"
          },
          "maxItems": 40
        },
        "needs_confirmation": {
          "description": "True when the user should be asked before credits are spent: something was ambiguous, unsupported, or there is nowhere to search.",
          "type": "boolean"
        },
        "ambiguities": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 200
          },
          "maxItems": 5
        },
        "unsupported": {
          "description": "Constraints the user stated that the spec cannot express, so the UI can say so rather than quietly ignoring them.",
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 200
          },
          "maxItems": 8
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "provenance": {
          "$ref": "#/$defs/ParseProvenance"
        }
      }
    },
    "Feasibility": {
      "title": "ParseFeasibility",
      "description": "Whether a filter can actually be searched on, or only applied afterwards (docs/08 capability map).",
      "type": "object",
      "additionalProperties": false,
      "required": ["filter", "mode"],
      "properties": {
        "filter": {
          "type": "string",
          "maxLength": 100
        },
        "mode": {
          "type": "string",
          "enum": ["directly_searchable", "post_filter", "estimate_only", "unsupported"]
        },
        "note": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "ParseProvenance": {
      "title": "ParseProvenance",
      "description": "Which model and prompt produced this reading (docs/07: every AI-derived value records both).",
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "prompt_version", "observed_at"],
      "properties": {
        "model": {
          "type": "string",
          "maxLength": 100
        },
        "prompt_version": {
          "type": "string",
          "maxLength": 100
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "cached": {
          "description": "True when the answer came from the gateway's response cache rather than a fresh model call.",
          "type": "boolean"
        }
      }
    },
    "ParseError": {
      "title": "ParseError",
      "type": "object",
      "additionalProperties": false,
      "required": ["error_class", "message"],
      "properties": {
        "error_class": {
          "type": "string",
          "enum": [
            "transient",
            "rate_limited",
            "access_restricted",
            "parse_failed",
            "invalid_input",
            "budget_exhausted"
          ]
        },
        "message": {
          "type": "string",
          "maxLength": 500
        }
      }
    }
  }
}
