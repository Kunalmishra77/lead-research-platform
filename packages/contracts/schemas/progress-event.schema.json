{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leadforge.dev/contracts/progress-event.schema.json",
  "title": "ProgressEvent",
  "description": "Published on Redis pub/sub progress:{id} and relayed as SSE (docs/01, docs/05). Version 1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_version",
    "job_id",
    "org_id",
    "trace_id",
    "stage",
    "status",
    "counts",
    "credits_used",
    "ts"
  ],
  "properties": {
    "event_version": {
      "const": 1
    },
    "job_id": {
      "type": "string",
      "format": "uuid",
      "description": "Research job id, or the job id for standalone jobs such as system.ping."
    },
    "org_id": {
      "type": ["string", "null"],
      "format": "uuid"
    },
    "trace_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "stage": {
      "type": "string",
      "enum": [
        "queued",
        "planning",
        "discovery",
        "crawling",
        "extracting",
        "resolving",
        "verifying",
        "enriching",
        "scoring",
        "exporting",
        "ping"
      ]
    },
    "status": {
      "type": "string",
      "enum": ["running", "completed", "failed", "paused", "cancelled"]
    },
    "counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      },
      "description": "Stage counters, e.g. {\"candidates\": 120}."
    },
    "credits_used": {
      "type": "integer",
      "minimum": 0
    },
    "message": {
      "type": ["string", "null"],
      "maxLength": 500
    },
    "error_class": {
      "type": ["string", "null"],
      "enum": [
        "transient",
        "rate_limited",
        "access_restricted",
        "parse_failed",
        "invalid_input",
        "budget_exhausted",
        null
      ]
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    }
  }
}
