{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leadforge.dev/contracts/research-spec.schema.json",
  "title": "ResearchSpec",
  "description": "Typed research request (docs/06 section 1). v1 skeleton; finalized in Phase 2 task 2.1.",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec_version", "entity", "intent", "filters", "fields", "depth", "limits"],
  "properties": {
    "spec_version": {
      "const": 1
    },
    "entity": {
      "type": "string",
      "enum": ["company"]
    },
    "intent": {
      "type": "string",
      "enum": ["prospecting", "market_map", "competitor_scan", "hiring_signal", "single_company"]
    },
    "filters": {
      "$ref": "#/$defs/Filters"
    },
    "keywords": {
      "$ref": "#/$defs/Keywords"
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true,
      "description": "Output field keys (field catalogue arrives in Phase 2). uniqueItems is enforced by the TS validator; specs are built and validated in the API."
    },
    "custom_columns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CustomColumn"
      }
    },
    "depth": {
      "type": "string",
      "enum": ["quick", "standard", "deep"]
    },
    "limits": {
      "$ref": "#/$defs/Limits"
    },
    "exclude": {
      "$ref": "#/$defs/Exclude"
    },
    "feasibility": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Feasibility"
      }
    }
  },
  "$defs": {
    "IncludeExclude": {
      "title": "IncludeExclude",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "include": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "IntRange": {
      "title": "IntRange",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gte": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "lte": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "allow_estimate": {
          "type": "boolean"
        }
      }
    },
    "Filters": {
      "title": "Filters",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "industry": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "include": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "exclude": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "taxonomy_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "location": {
          "$ref": "#/$defs/Location"
        },
        "employee_count": {
          "$ref": "#/$defs/IntRange"
        },
        "has_website": {
          "type": ["boolean", "null"]
        },
        "contact": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "any_of": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["email", "phone", "whatsapp", "contact_form"]
              }
            }
          }
        },
        "social": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/SocialFilter"
          }
        },
        "technologies": {
          "$ref": "#/$defs/IncludeExclude"
        },
        "hiring": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "required": {
              "type": "boolean"
            },
            "departments": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "funding": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "last_round_within_days": {
              "type": ["integer", "null"],
              "minimum": 1
            }
          }
        },
        "rating": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "gte": {
              "type": ["number", "null"],
              "minimum": 0,
              "maximum": 5
            },
            "min_reviews": {
              "type": ["integer", "null"],
              "minimum": 0
            }
          }
        },
        "min_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "Location": {
      "title": "Location",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "country": {
          "type": "string",
          "pattern": "^[A-Z]{2}$",
          "description": "ISO-3166 alpha-2"
        },
        "states": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "radius_km": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0
        },
        "include_metro_area": {
          "type": "boolean"
        }
      }
    },
    "SocialFilter": {
      "title": "SocialFilter",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "boolean"
        },
        "active_within_days": {
          "type": ["integer", "null"],
          "minimum": 1
        }
      }
    },
    "Keywords": {
      "title": "Keywords",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "must": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "should": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "not": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "CustomColumn": {
      "title": "CustomColumn",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "prompt", "output_type"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "output_type": {
          "type": "string",
          "enum": ["boolean", "text", "number", "enum"]
        }
      }
    },
    "Limits": {
      "title": "Limits",
      "type": "object",
      "additionalProperties": false,
      "required": ["max_results", "max_credits"],
      "properties": {
        "max_results": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "max_credits": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "Exclude": {
      "title": "Exclude",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lists": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "existing_leads": {
          "type": "boolean"
        }
      }
    },
    "Feasibility": {
      "title": "Feasibility",
      "type": "object",
      "additionalProperties": false,
      "required": ["filter", "mode"],
      "properties": {
        "filter": {
          "type": "string"
        },
        "mode": {
          "type": "string",
          "enum": ["directly_searchable", "post_filter", "estimate_only"]
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
