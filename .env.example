# ---------- Core ----------
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
LOG_LEVEL=debug

# ---------- Database ----------
DATABASE_URL=postgresql://leadforge:leadforge@localhost:5432/leadforge
DATABASE_URL_WORKERS=postgresql://leadforge_worker:leadforge@localhost:5432/leadforge

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379/0

# ---------- Object storage (MinIO locally, R2 in prod) ----------
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET_RAW=lf-raw
S3_BUCKET_EXPORTS=lf-exports
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# ---------- Auth ----------
BETTER_AUTH_SECRET=change-me-32-bytes-min
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ---------- Encryption ----------
# Local dev only. Prod uses KMS/Vault; never a static key.
DATA_ENCRYPTION_MASTER_KEY=base64-32-bytes-dev-only

# ---------- Data sources ----------
GOOGLE_PLACES_API_KEY=
SERP_PROVIDER=serper
SERP_API_KEY=
COMPANIES_HOUSE_API_KEY=
OPENCORPORATES_API_KEY=
EMAIL_VERIFIER_PROVIDER=
EMAIL_VERIFIER_API_KEY=
CRAWLER_USER_AGENT="LeadForgeBot/0.1 (+https://example.com/bot)"

# ---------- AI ----------
AI_PROVIDER_PRIMARY=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_MODEL_SMALL=
AI_MODEL_LARGE=
EMBEDDING_MODEL=

# ---------- Billing ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------- Observability ----------
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
POSTHOG_KEY=
