# Copy to the repo root as `.env` and fill in the <...> values. Never commit `.env`.
# (Kept here because the agent tooling cannot edit `.env.example`; this file is the source of truth.)

# ---------- Core ----------
NODE_ENV=development
LOG_LEVEL=debug
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
# Dev only: resolve *.supabase.co over DNS-over-HTTPS (some Indian ISPs sinkhole it). See ADR-0002.
DEV_DNS_OVER_HTTPS=true

# ---------- Database (Supabase, ADR-0002/0003) ----------
SUPABASE_PROJECT_REF=<project-ref>
# Owner role, session pooler: migrations + infra:bootstrap only
DATABASE_URL_MIGRATIONS=postgresql://postgres.<project-ref>:<db-password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# App role passwords (>= 16 chars, random); infra:bootstrap sets them on the roles
APP_API_DB_PASSWORD=<random>
APP_WORKER_DB_PASSWORD=<random>
# App roles, transaction pooler
DATABASE_URL=postgresql://app_api.<project-ref>:<APP_API_DB_PASSWORD>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL_WORKERS=postgresql://app_worker.<project-ref>:<APP_WORKER_DB_PASSWORD>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# ---------- Supabase Auth ----------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<Project Settings -> API Keys -> publishable key>
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# ---------- Redis (local portable Redis: `pnpm redis:start`) ----------
REDIS_URL=redis://127.0.0.1:6379/0

# ---------- Object storage (Supabase Storage S3) ----------
S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
S3_REGION=ap-south-1
S3_BUCKET_RAW=lf-raw
S3_BUCKET_EXPORTS=lf-exports
S3_ACCESS_KEY_ID=<Storage -> S3 Connection -> access key>
S3_SECRET_ACCESS_KEY=<secret>

# ---------- Later phases ----------
DATA_ENCRYPTION_MASTER_KEY=
SENTRY_DSN=
GOOGLE_PLACES_API_KEY=
SERP_PROVIDER=serper
SERP_API_KEY=
CRAWLER_USER_AGENT="LeadForgeBot/0.1 (+https://example.com/bot)"
AI_PROVIDER_PRIMARY=anthropic
ANTHROPIC_API_KEY=
