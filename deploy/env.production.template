# Environment for the deployed stack. Paste these into Coolify's environment for the resource,
# not into a file in the repo — .env is git-ignored for a reason and a committed secret is a
# rotated secret.
#
# Every value here is required unless it says otherwise. The API refuses to start if any of its
# required keys are missing, which is deliberate: a half-configured API that starts and then
# fails every request is harder to diagnose than one that says what is missing.

# --- where it lives -----------------------------------------------------------------------------
# The public URL people open. Must match what Coolify serves, including https.
APP_URL=https://app.example.com
# Where the API is reachable from the browser's point of view. The web container talks to the API
# over the internal network (http://api:4000, set in docker-compose.yml), so this is only used for
# absolute links.
API_URL=https://app.example.com
NODE_ENV=production
LOG_LEVEL=info

# --- Supabase (already hosted) --------------------------------------------------------------
# Project settings -> API. The JWKS URL must be on the same origin as SUPABASE_URL.
SUPABASE_URL=https://YOUR_REF.supabase.co
SUPABASE_JWKS_URL=https://YOUR_REF.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_PUBLISHABLE_KEY=

# --- database ---------------------------------------------------------------------------------
# Three roles, three URLs, on purpose (ADR-0003): the API and the workers have different grants,
# and neither may run migrations. Use the transaction pooler (port 6543) for the app roles.
DATABASE_URL=postgresql://app_api:PASSWORD@HOST:6543/postgres
DATABASE_URL_WORKERS=postgresql://app_worker:PASSWORD@HOST:6543/postgres
# Only the migration job needs this one. Do not give it to the API or the workers.
DATABASE_URL_MIGRATIONS=postgresql://postgres:PASSWORD@HOST:5432/postgres

# --- storage (Supabase Storage, S3-compatible) ------------------------------------------------
# Required: the API will not start without them.
S3_ENDPOINT=https://YOUR_REF.supabase.co/storage/v1/s3
S3_REGION=ap-south-1
S3_BUCKET_RAW=raw
S3_BUCKET_EXPORTS=exports
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- the keys that cost money -----------------------------------------------------------------
# Models: the parse endpoint and the planner's query expansion.
OPENAI_API_KEY=
# Google Places: about $0.035 a search at the Enterprise field mask we use.
GOOGLE_PLACES_API_KEY=
# Off until you mean it. With this false a search runs and correctly reports that no source can
# find businesses; with it true, every search spends real money (ADR-0011).
GOOGLE_PLACES_ENABLED=false
# Optional. Finds a website for businesses Google had none for.
SERPER_API_KEY=

# --- behind Coolify's proxy -------------------------------------------------------------------
# Coolify fronts the containers, so without this every request looks like it came from the proxy
# and the per-org rate limits would all share one bucket. Set it to the proxy's network, e.g.
# 10.0.0.0/8, or leave blank if you are not sure and accept that limits are coarser.
TRUST_PROXY=

# --- tuning (sensible defaults; change only with a reason) --------------------------------------
COST_CAP_MICROS_PER_CREDIT=20000
PARSE_RATE_PER_MINUTE=30
JOBS_DISCOVERY_POOL=discovery

# --- error reporting (optional) ------------------------------------------------------------------
SENTRY_DSN_API=
SENTRY_DSN_WEB=
SENTRY_DSN_WORKERS=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
